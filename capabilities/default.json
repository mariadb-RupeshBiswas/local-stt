{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least privilege: events, window dragging, clipboard write, and the app's own commands.",
  "windows": ["overlay", "main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "clipboard-manager:allow-write-text"
  ]
}
