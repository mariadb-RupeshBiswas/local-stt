{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Recording pill: listen to its own events, be dragged, read the theme. Nothing else.",
  "windows": ["overlay"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-get-state"
  ]
}
